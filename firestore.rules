rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function approved() {
   return request.auth != null &&
    exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['gwyn','mum','dad'];
  }
  function myRole() {
   return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
  }
  match /profiles/{uid} {
   allow read: if approved() && request.auth.uid == uid;
   allow write: if false;
  }
  match /entries/{entryId} {
   allow read: if approved();
   allow create: if approved() && request.resource.data.keys().hasOnly(['uid','role','date','data','updatedAt']) &&
    request.resource.data.uid == request.auth.uid &&
    request.resource.data.role == myRole() &&
    request.resource.data.date is string &&
    entryId == myRole() + '_' + request.auth.uid + '_' + request.resource.data.date;
   allow update: if approved() && resource.data.uid == request.auth.uid &&
    request.resource.data.uid == resource.data.uid &&
    request.resource.data.role == resource.data.role &&
    request.resource.data.date == resource.data.date &&
    request.resource.data.keys().hasOnly(['uid','role','date','data','updatedAt']);
   allow delete: if false;
  }
 }
}
